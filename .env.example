# ---- Supabase ----
# Google sign-in is configured in the Supabase dashboard
# (Authentication -> Providers -> Google), not here. The app never sees the
# Google client secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser — bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay (Week 3) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- LiveKit (session room) ----
# URL and key identify the project; the SECRET signs join tokens and is
# server-only — it must never reach the browser.
NEXT_PUBLIC_LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Platform ----
PLATFORM_COMMISSION_PERCENT=25
NEXT_PUBLIC_SITE_URL=http://localhost:3000
